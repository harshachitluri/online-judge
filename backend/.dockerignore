# =============================================================
# .dockerignore — backend
# Files excluded from the Docker build context (COPY . .)
# =============================================================

# Dependencies — reinstalled inside the image via npm ci
node_modules

# Environment secrets — injected at runtime via docker-compose / env vars
.env
.env.*

# Temp code execution files — mounted as a volume at runtime
src/temp/

# Logs
*.log
npm-debug.log*

# OS artifacts
.DS_Store
Thumbs.db

# Git
.git
.gitignore

# Editor configs
.vscode
.idea

# Test output
coverage/

# The runner image Dockerfile — not needed in the server image
Dockerfile.runner

# =============================================================
# CodeJudge — Sandboxed Code Runner Image
# =============================================================
# Pattern: Alpine-based (same as backend) — lightweight & fast
#
# WHY THIS IMAGE EXISTS (from your notes, Image 3 & 4):
#   User code (Python, C++, Java) can "crash the system" (security).
#   We need to ISOLATE the compiler service → Docker solves this.
#   This image runs ONLY user code — never the backend server.
#
# Tools installed:
#   g++           → compile and run C++
#   openjdk17-jdk → javac (compile) + java (run) for Java
#   python3       → run Python scripts (no compile step needed)
#   coreutils     → provides the `timeout` binary (mandatory for TLE)
#
# Build (Dockerfile → Docker Image, per your Image 2 notes):
#   docker build -f backend/Dockerfile.runner -t codejudge-runner .
# =============================================================

FROM alpine:3.19

# apk — Alpine's package manager (same pattern as backend's apk add)
RUN apk update && apk add --no-cache \
    g++ \
    openjdk17-jdk \
    python3 \
    coreutils

# ── Language-specific env flags ─────────────────────────────────
# Python: don't write .pyc files (container filesystem is read-only)
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Java: disable class-data sharing (avoids write attempts at startup)
ENV _JAVA_OPTIONS="-Xshare:off"
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk

WORKDIR /sandbox

# =============================================================================
# CodeJudge — production environment
# =============================================================================
# Copy to .env on the server and fill in. Never commit the filled-in copy —
# .gitignore already excludes .env, and .dockerignore keeps it out of images.
#
#   cp .env.example .env && nano .env
# =============================================================================

# ── Core (required — compose refuses to start without these) ─────────────────

# MongoDB Atlas connection string. Note the database name before the "?" —
# without it, everything silently lands in a database called "test".
MONGO_URI="mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/onlinejudge?retryWrites=true&w=majority"

# Generate a fresh one for production, do NOT reuse a development secret:
#   openssl rand -base64 48
JWT_SECRET=""

# The exact origin the browser loads, scheme included. Comma-separate for
# multiple. Wrong value here = every API call blocked by CORS.
CORS_ORIGIN="https://codejudge.example.com"

PORT=5001

# ── Cookies ──────────────────────────────────────────────────────────────────
# "lax" when Caddy serves the SPA and the API on one domain (the setup in
# Caddyfile) — safer, and blocks cross-site CSRF for free.
# "none" ONLY if the frontend is on a different domain than the API.
COOKIE_SAMESITE=lax

# ── Judge sandbox ────────────────────────────────────────────────────────────

DOCKER_ENABLED=true

# ── Image source ─────────────────────────────────────────────────────────────
# Leave ECR_REGISTRY empty to build locally (development). Set it and deploy.sh
# pulls prebuilt images from ECR instead — which is what you want on the
# server, where building competes with the running app for 1GB of RAM.
#
# ECR_REGISTRY=123456789012.dkr.ecr.ap-south-1.amazonaws.com
# AWS_REGION=ap-south-1
# BACKEND_IMAGE=123456789012.dkr.ecr.ap-south-1.amazonaws.com/codejudge-backend:latest
# DOCKER_RUNNER_IMAGE=123456789012.dkr.ecr.ap-south-1.amazonaws.com/codejudge-runner:latest
ECR_REGISTRY=
AWS_REGION=ap-south-1
BACKEND_IMAGE=codejudge-backend:latest
DOCKER_RUNNER_IMAGE=codejudge-runner:latest
DOCKER_MEMORY=256m
DOCKER_CPUS=0.5
DOCKER_PIDS_LIMIT=50

# Concurrent submissions. Each can hold DOCKER_MEMORY, so on a 1GB box
# (AWS t3.micro) keep this at 2. Raise it with the instance size.
MAX_CONCURRENT_JOBS=2

# ── Email (one-time codes, password reset) ───────────────────────────────────
# Gmail needs an App Password, not your account password. Unset, codes are
# printed to the server log instead of sent — fine for a smoke test, useless
# for real users.
FRONTEND_URL="https://codejudge.example.com"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="CodeJudge <no-reply@codejudge.example.com>"

# ── Optional integrations ────────────────────────────────────────────────────
# Both degrade honestly when unset: the AI Assistant returns a clear
# "not configured" error, and the Google button renders a disabled state.

GEMINI_API_KEY=""
GEMINI_MODEL=gemini-2.0-flash

# Must match REACT_APP_GOOGLE_CLIENT_ID used at frontend build time, and the
# domain must be listed in the Client ID's Authorized JavaScript origins.
GOOGLE_CLIENT_ID=""

# ── Seeding ──────────────────────────────────────────────────────────────────
# seedProblems.js refuses to create a default admin in production unless this
# is set. Prefer leaving it unset and using src/scripts/makeAdmin.js instead:
# register normally through the site, then promote that account.
# SEED_ADMIN_PASSWORD=""

# Root .dockerignore — the build context is now the repo root (both targets
# in the single Dockerfile COPY from here), so this replaces backend/.dockerignore.

node_modules
**/node_modules

# Both forms are required. A bare ".env" matches ONLY the context root —
# it does not match backend/.env, which is exactly where the real secrets
# live. Without the "**/" variants they get COPYed into the image and ship
# with it: anyone who can pull or docker-save the image reads your database
# password, JWT secret and API keys.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

backend/src/temp/

*.log
npm-debug.log*

.DS_Store
Thumbs.db

.git
.gitignore

.vscode
.idea

coverage/

# The frontend is built separately (Caddy serves the static output) and
# isn't part of either Docker target.
frontend/
